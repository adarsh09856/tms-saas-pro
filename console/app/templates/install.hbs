<div class="min-h-screen flex flex-col items-center justify-center px-6 py-12">
    <div class="w-full max-w-xl border border-gray-800 bg-gray-900 shadow-md rounded-md p-8 text-center">
        <img src="/images/transport-diary-icon.svg?v=20261127-diary" alt={{t "app.name"}} class="w-12 h-12 mx-auto" width="48" height="48" />
        <h1 class="mt-4 text-2xl font-bold text-gray-50">{{t "install.not-configured-title"}}</h1>
        <p class="mt-3 text-sm leading-6 text-gray-300">{{t "install.not-configured-message"}}</p>

        {{#if this.isRefreshing}}
            <p class="mt-4 text-sm font-medium text-sky-300">{{t "install.refreshing"}}</p>
        {{/if}}

    </div>
    <FleetbaseAttribution />
</div>
