{{page-title "Authentication"}}
<Layout::Section::Header @title="Authentication" />

<Layout::Section::Body class="overflow-y-scroll h-full">
    <div class="tms-settings-page">
        <div class="tms-settings-content space-y-6">
            <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-slate-700 dark:border-blue-900 dark:bg-slate-900 dark:text-slate-200" role="note">
                <p class="font-semibold text-slate-900 dark:text-white">Company-wide sign-in policy</p>
                <p class="mt-1">This setting controls whether members can change their own password. When disabled, administrators and members granted the <code>iam change-password</code> permission can still change passwords; invited users can set their first password.</p>
            </div>
            <ContentPanel @title="Passwords" @open={{true}} @wrapperClass="bordered-classic">
                {{#if this.loadAuthSettings.isIdle}}
                    <div class="flex items-center space-x-4">
                        <label class="text-base font-medium">Allow users to change their own password</label>
                        <Toggle @isToggled={{this.allowUsersChangePassword}} @onToggle={{this.onAllowUsersChangePasswordToggled}} />
                    </div>
                {{else}}
                    <div class="flex items-center justify-center p-4">
                        <Spinner @loadingMessage="Loading authentication settings..." @wrapperClass="flex flex-row" @iconClass="mr-2" />
                    </div>
                {{/if}}
                <div class="mt-4">
                    <Button
                        @type="primary"
                        @buttonType="submit"
                        @text="Save Authentication Settings"
                        @icon="save"
                        @onClick={{perform this.saveAuthSettings}}
                        @isLoading={{this.saveAuthSettings.isRunning}}
                        @disabled={{not this.loadAuthSettings.isIdle}}
                    />
                </div>
            </ContentPanel>
        </div>
    </div>

</Layout::Section::Body>
