{{page-title "Activity"}}

<div class="tms-company-subpage mx-auto flex w-full max-w-7xl flex-col gap-4 p-4 md:p-6">
    <div class="tms-company-subpage-heading">
        <div><p class="tms-workspace-eyebrow">Company history</p><h2>Activity stream</h2><p>Review recorded changes and events for this company workspace.</p></div>
    </div>

    <RegistryYield @registry="console:admin:organization:activity" @context={{hash organization=@model}} as |RegistryComponent context|>
        <RegistryComponent @organization={{context.organization}} />
    </RegistryYield>

    <section class="tms-admin-data-panel overflow-hidden rounded-md border bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <ActivityLog
            @companyUuid={{@model.uuid}}
            @showBadges={{true}}
            @headerWrapperClass="border-b border-gray-200 px-4 py-3 dark:border-gray-700"
            class="p-4"
        />
    </section>
</div>
