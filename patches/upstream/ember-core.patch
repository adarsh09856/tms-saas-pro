diff --git a/tests/unit/utils/notification-error-message-test.js b/tests/unit/utils/notification-error-message-test.js
new file mode 100644
index 0000000..11253c0
--- /dev/null
+++ b/tests/unit/utils/notification-error-message-test.js
@@ -0,0 +1,20 @@
+import { module, test } from 'qunit';
+import notificationErrorMessage from '@fleetbase/ember-core/utils/notification-error-message';
+
+module('Unit | Utility | notification-error-message', function () {
+    test('extracts API and validation feedback as text', function (assert) {
+        assert.strictEqual(notificationErrorMessage({ errors: [{ detail: 'Select a driver.' }] }, 'Fallback'), 'Select a driver.');
+        assert.strictEqual(notificationErrorMessage({ errors: { pickup: ['Pickup is required.'] } }, 'Fallback'), 'Pickup is required.');
+        assert.strictEqual(notificationErrorMessage(new Error('Connection failed.'), 'Fallback'), 'Connection failed.');
+        assert.strictEqual(notificationErrorMessage('{"errors":[{"message":"Permission denied."}]}', 'Fallback'), 'Permission denied.');
+        assert.strictEqual(notificationErrorMessage('plain message', 'Fallback'), 'plain message');
+    });
+
+    test('falls back for unrenderable or circular payloads', function (assert) {
+        const cycle = {};
+        cycle.errors = cycle;
+        for (const payload of [{ errors: [] }, { status: 500 }, '{bad json', cycle]) {
+            assert.strictEqual(notificationErrorMessage(payload, 'Fallback'), 'Fallback');
+        }
+    });
+});
