diff --git a/addon/utils/notification-error-message.js b/addon/utils/notification-error-message.js
new file mode 100644
index 0000000..57eefe4
--- /dev/null
+++ b/addon/utils/notification-error-message.js
@@ -0,0 +1,37 @@
+/** Extract readable API feedback without rendering an object or JSON document. */
+export default function notificationErrorMessage(error, fallback) {
+    const seen = new WeakSet();
+    function read(value, depth = 0) {
+        if (depth > 8 || value == null) return null;
+        if (typeof value === 'string') {
+            const text = value.trim();
+            if (!text) return null;
+            if (text.startsWith('{') || text.startsWith('[')) {
+                try {
+                    return read(JSON.parse(text), depth + 1);
+                } catch {
+                    return null;
+                }
+            }
+            return text;
+        }
+        if (typeof value !== 'object' || seen.has(value)) return null;
+        seen.add(value);
+        if (Array.isArray(value)) {
+            for (const entry of value) {
+                const message = read(entry, depth + 1);
+                if (message) return message;
+            }
+            return null;
+        }
+        for (const key of ['errors', 'detail', 'message', 'error', 'title']) {
+            const candidate = value[key];
+            // Validation errors can be keyed by field name.
+            const entries = key === 'errors' && candidate && typeof candidate === 'object' && !Array.isArray(candidate) ? Object.values(candidate) : candidate;
+            const message = read(entries, depth + 1);
+            if (message) return message;
+        }
+        return null;
+    }
+    return read(error) || fallback;
+}
