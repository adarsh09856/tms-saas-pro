diff --git a/server/src/Http/Controllers/Internal/v1/Concerns/EnforcesTmsCurrency.php b/server/src/Http/Controllers/Internal/v1/Concerns/EnforcesTmsCurrency.php
new file mode 100644
index 0000000..1befafd
--- /dev/null
+++ b/server/src/Http/Controllers/Internal/v1/Concerns/EnforcesTmsCurrency.php
@@ -0,0 +1,153 @@
+<?php
+
+namespace Fleetbase\Ledger\Http\Controllers\Internal\v1\Concerns;
+
+use Illuminate\Http\Request;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Enforce INR on newly entered TMS financial records without rewriting stored
+ * currencies when an existing historical record is edited.
+ */
+trait EnforcesTmsCurrency
+{
+    protected function setNewRecordCurrency(Request $request, string $resourceKey): void
+    {
+        $payload = $request->input($resourceKey);
+        $nested  = is_array($payload);
+        $currency = strtoupper((string) ($nested ? ($payload['currency'] ?? 'INR') : $request->input('currency', 'INR')));
+
+        if ($currency !== 'INR') {
+            throw ValidationException::withMessages(['currency' => ['New TMS financial records must use INR.']]);
+        }
+
+        if ($nested) {
+            $payload['currency'] = 'INR';
+            $request->merge([$resourceKey => $payload]);
+        } else {
+            $request->merge(['currency' => 'INR']);
+        }
+    }
+
+    protected function preserveStoredCurrency(Request $request, string $resourceKey, ?string $storedCurrency): void
+    {
+        $payload = $request->input($resourceKey);
+        $nested  = is_array($payload);
+        $hasCurrency = $nested
+            ? array_key_exists('currency', $payload)
+            : $request->exists('currency');
+
+        if (!$hasCurrency) {
+            return;
+        }
+
+        $submitted = $nested ? $payload['currency'] : $request->input('currency');
+        $submitted = is_string($submitted) ? strtoupper($submitted) : $submitted;
+        $stored     = $storedCurrency === null ? null : strtoupper($storedCurrency);
+
+        if ($submitted !== $stored) {
+            throw ValidationException::withMessages([
+                'currency' => ['A saved financial record currency cannot be changed. Create new records in INR.'],
+            ]);
+        }
+
+        if ($nested) {
+            $payload['currency'] = $storedCurrency;
+            $request->merge([$resourceKey => $payload]);
+        } else {
+            $request->merge(['currency' => $storedCurrency]);
+        }
+    }
+
+    protected function assertNewGatewayConfigCurrency(Request $request): void
+    {
+        $config = $request->input('gateway.config', $request->input('config', []));
+        foreach ($this->currencyConfigValues(is_array($config) ? $config : []) as $value) {
+            if (!is_string($value) || strtoupper($value) !== 'INR') {
+                throw ValidationException::withMessages([
+                    'config.currency' => ['New TMS gateway currency settings must use INR.'],
+                ]);
+            }
+        }
+    }
+
+    protected function preserveGatewayConfigCurrency(Request $request, array $storedConfig): void
+    {
+        $config = $request->input('gateway.config', $request->input('config'));
+        if (!is_array($config)) {
+            return;
+        }
+
+        $config = $this->restoreStoredCurrencyConfig($config, $storedConfig);
+        $submittedCurrencies = $this->currencyConfigValues($config);
+        $storedCurrencies    = $this->currencyConfigValues($storedConfig);
+
+        foreach ($submittedCurrencies as $path => $value) {
+            if (array_key_exists($path, $storedCurrencies)) {
+                if (strtoupper((string) $value) !== strtoupper((string) $storedCurrencies[$path])) {
+                    throw ValidationException::withMessages([
+                        'config.currency' => ['Saved gateway currency settings cannot be changed.'],
+                    ]);
+                }
+                continue;
+            }
+
+            if (!is_string($value) || strtoupper($value) !== 'INR') {
+                throw ValidationException::withMessages([
+                    'config.currency' => ['New TMS gateway currency settings must use INR.'],
+                ]);
+            }
+        }
+
+        $this->replaceGatewayConfig($request, $config);
+    }
+
+    private function currencyConfigValues(array $config): array
+    {
+        $currencies = [];
+        foreach ($config as $key => $value) {
+            if (preg_match('/currency$/i', (string) $key)) {
+                $currencies[(string) $key] = $value;
+            } elseif (is_array($value)) {
+                foreach ($this->currencyConfigValues($value) as $nestedKey => $nestedValue) {
+                    $currencies[$key . '.' . $nestedKey] = $nestedValue;
+                }
+            }
+        }
+
+        ksort($currencies);
+
+        return $currencies;
+    }
+
+    private function restoreStoredCurrencyConfig(array $submitted, array $stored): array
+    {
+        foreach ($stored as $key => $value) {
+            if (preg_match('/currency$/i', (string) $key)) {
+                if (!array_key_exists($key, $submitted)) {
+                    $submitted[$key] = $value;
+                }
+            } elseif (is_array($value)) {
+                if (isset($submitted[$key]) && is_array($submitted[$key])) {
+                    $submitted[$key] = $this->restoreStoredCurrencyConfig($submitted[$key], $value);
+                } elseif ($this->currencyConfigValues($value) !== []) {
+                    $submitted[$key] = $value;
+                }
+            }
+        }
+
+        return $submitted;
+    }
+
+    private function replaceGatewayConfig(Request $request, array $config): void
+    {
+        $gatewayPayload = $request->input('gateway');
+        if (is_array($gatewayPayload) && array_key_exists('config', $gatewayPayload)) {
+            $gatewayPayload['config'] = $config;
+            $request->merge(['gateway' => $gatewayPayload]);
+            return;
+        }
+
+        $request->merge(['config' => $config]);
+    }
+}
