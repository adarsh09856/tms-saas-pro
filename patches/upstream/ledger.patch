new file mode 100644
index 0000000..2b800f6
--- /dev/null
+++ b/server/tests/Unit/Support/EnforcesTmsCurrencyTest.php
@@ -0,0 +1,76 @@
+<?php
+
+use Fleetbase\Ledger\Http\Controllers\Internal\v1\Concerns\EnforcesTmsCurrency;
+use Illuminate\Http\Request;
+use Illuminate\Validation\ValidationException;
+
+class EnforcesTmsCurrencyHarness
+{
+    use EnforcesTmsCurrency;
+
+    public function create(Request $request, string $resourceKey = 'wallet'): void
+    {
+        $this->setNewRecordCurrency($request, $resourceKey);
+    }
+
+    public function preserve(Request $request, string $stored, string $resourceKey = 'wallet'): void
+    {
+        $this->preserveStoredCurrency($request, $resourceKey, $stored);
+    }
+
+    public function newGatewayConfig(Request $request): void
+    {
+        $this->assertNewGatewayConfigCurrency($request);
+    }
+
+    public function preserveGatewayConfig(Request $request, array $stored): void
+    {
+        $this->preserveGatewayConfigCurrency($request, $stored);
+    }
+}
+
+test('new TMS records default to INR and reject explicit non-INR currencies', function () {
+    $policy = new EnforcesTmsCurrencyHarness();
+    $request = Request::create('/ledger/wallets', 'POST', ['wallet' => ['name' => 'Operating']]);
+
+    $policy->create($request);
+
+    expect($request->input('wallet.currency'))->toBe('INR');
+
+    $invalid = Request::create('/ledger/wallets', 'POST', ['currency' => 'USD']);
+    expect(fn () => $policy->create($invalid))->toThrow(ValidationException::class);
+});
+
+test('saved non-INR currencies can be submitted unchanged but cannot be relabeled', function () {
+    $policy = new EnforcesTmsCurrencyHarness();
+    $same = Request::create('/ledger/wallets/wallet-one', 'PUT', ['wallet' => ['currency' => 'usd']]);
+    $policy->preserve($same, 'USD');
+    expect($same->input('wallet.currency'))->toBe('USD');
+
+    $changed = Request::create('/ledger/wallets/wallet-one', 'PUT', ['wallet' => ['currency' => 'INR']]);
+    expect(fn () => $policy->preserve($changed, 'USD'))->toThrow(ValidationException::class);
+});
+
+test('invoice entry policy defaults new invoices to INR and keeps historical invoice currencies immutable', function () {
+    $policy = new EnforcesTmsCurrencyHarness();
+    $newInvoice = Request::create('/ledger/invoices', 'POST', ['invoice' => ['number' => 'INV-NEW']]);
+    $policy->create($newInvoice, 'invoice');
+    expect($newInvoice->input('invoice.currency'))->toBe('INR');
+
+    $historical = Request::create('/ledger/invoices/invoice-one', 'PUT', ['invoice' => ['currency' => 'BTN']]);
+    $policy->preserve($historical, 'BTN', 'invoice');
+    expect($historical->input('invoice.currency'))->toBe('BTN');
+});
+
+test('gateway currency configuration is INR for new gateways and immutable on existing gateways', function () {
+    $policy = new EnforcesTmsCurrencyHarness();
+    $policy->newGatewayConfig(Request::create('/ledger/gateways', 'POST', ['config' => ['api_key' => 'secret', 'currency' => 'inr']]));
+
+    expect(fn () => $policy->newGatewayConfig(Request::create('/ledger/gateways', 'POST', ['config' => ['currency' => 'USD']])))->toThrow(ValidationException::class);
+
+    $same = Request::create('/ledger/gateways/gateway-one', 'PUT', ['config' => ['currency' => 'USD']]);
+    $policy->preserveGatewayConfig($same, ['currency' => 'USD']);
+
+    $changed = Request::create('/ledger/gateways/gateway-one', 'PUT', ['config' => ['currency' => 'INR']]);
+    expect(fn () => $policy->preserveGatewayConfig($changed, ['currency' => 'USD']))->toThrow(ValidationException::class);
+});
